#!/bin/sh

# BEAM's allocators (particularly the binary allocator, given how much of this
# app's work is binary-heavy: parsing yt-dlp's JSON output, HTTP response bodies
# for thumbnails/metadata, piping subprocess stdout) hold onto memory "carriers"
# fetched from the OS rather than promptly returning them once they're no longer
# needed - so the process's RSS can climb well past what :erlang.memory/0 reports
# as actually in use, even with no real leak. `aobf` (address order best fit)
# favors reusing existing carrier space over grabbing new memory from the OS,
# which keeps RSS closer to what's actually live.
export ERL_FLAGS="${ERL_FLAGS} +MBas aobf"
