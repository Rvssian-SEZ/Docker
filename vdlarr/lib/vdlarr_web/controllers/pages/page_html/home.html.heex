<div class="mb-6 flex flex-row items-center justify-between gap-3">
  <h2 class="font-display text-[22px] font-bold text-white">History</h2>
  <span class="text-sm text-[#92a1b4]">
    <.localized_number number={@media_item_count} /> downloaded · <.readable_filesize byte_size={@media_item_size} />
  </span>
</div>

<div class="rounded-xl border border-white/5 bg-midnight-850 p-5">
  {live_render(@conn, Vdlarr.Pages.HistoryTableLive, session: %{"media_state" => "downloaded"})}
</div>
