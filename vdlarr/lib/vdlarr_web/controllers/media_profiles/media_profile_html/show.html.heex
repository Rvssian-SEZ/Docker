<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <div class="flex items-center min-w-0">
    <.link href={~p"/media_profiles"}>
      <.icon name="hero-arrow-left" class="w-8 h-8 text-slate-400 hover:text-white transition-colors" />
    </.link>
    <h2 class="font-display font-bold text-[22px] text-white ml-2 truncate">
      {@media_profile.name}
    </h2>
  </div>

  <nav>
    <.link href={~p"/media_profiles/#{@media_profile}/edit"}>
      <.button color="bg-primary" rounding="rounded-lg">
        <.icon name="hero-pencil-square" class="mr-2" />Edit <span class="hidden sm:inline pl-1">Media Profile</span>
      </.button>
    </.link>
  </nav>
</div>
<div class="rounded-xl border border-white/5 bg-midnight-850 px-5 pb-2.5 pt-6 sm:px-7.5 xl:pb-1">
  <div class="max-w-full">
    <.tabbed_layout>
      <:tab_append>
        <.actions_dropdown media_profile={@media_profile} />
      </:tab_append>

      <:tab title="Overview" id="media-profile">
        <div class="mt-6 flex flex-col gap-8 text-white" data-testid="profile-overview">
          <div class="rounded-lg border border-m3-border bg-midnight-800 p-4">
            <div class="text-[11px] font-semibold uppercase tracking-wide text-[#7d8da2]">Output path</div>
            <code class="mt-1 block break-all font-mono text-[13px] text-[#c9e2ff]">{@media_profile.output_path_template}</code>
            <div class="mt-2 text-xs text-[#7d8da2]">
              Saves into <span class="font-mono text-[#b9c7dc]">{download_folder_path(@media_profile)}</span>
              ({if @media_profile.root_folder, do: "#{@media_profile.root_folder.name} root", else: "default root"}) ·
              used by <.localized_number number={length(@sources)} />
              {if length(@sources) == 1, do: "source", else: "sources"}
            </div>
          </div>

          <dl class="grid gap-x-8 gap-y-5 sm:grid-cols-2 xl:grid-cols-3">
            <.detail_item label="Resolution">{@media_profile.preferred_resolution}</.detail_item>
            <.detail_item label="Container">{@media_profile.media_container || "Automatic"}</.detail_item>
            <.detail_item label="Audio track">{@media_profile.audio_track || "Default"}</.detail_item>
            <.detail_item label="Subtitles">{subtitles_label(@media_profile)}</.detail_item>
            <.detail_item label="Thumbnail">{thumbnail_label(@media_profile)}</.detail_item>
            <.detail_item label="Channel art">
              {if @media_profile.download_source_images, do: "Poster, fanart and banner saved", else: "Off"}
            </.detail_item>
            <.detail_item label="Metadata">{metadata_label(@media_profile)}</.detail_item>
            <.detail_item label="SponsorBlock">{sponsorblock_label(@media_profile)}</.detail_item>
            <.detail_item label="Shorts">{content_label(@media_profile.shorts_behaviour, "shorts")}</.detail_item>
            <.detail_item label="Livestreams">
              {content_label(@media_profile.livestream_behaviour, "livestreams")}
            </.detail_item>
            <.detail_item label="Quality upgrades">{redownload_label(@media_profile.redownload_delay_days)}</.detail_item>
          </dl>

          <details class="rounded-lg border border-m3-border bg-midnight-900/60">
            <summary class="cursor-pointer select-none px-4 py-3 text-sm font-medium text-[#b9c7dc] hover:text-white">
              Advanced: all fields
            </summary>
            <div class="border-t border-m3-border px-4 pb-4">
              <.list_items_from_map map={Map.from_struct(@media_profile)} />
            </div>
          </details>
        </div>
      </:tab>
      <:tab title="Sources" id="sources">
        <.table rows={@sources} table_class="text-white">
          <:col :let={source} label="Name">
            <.subtle_link href={~p"/sources/#{source.id}"}>
              {source.custom_name || source.collection_name}
            </.subtle_link>
          </:col>
          <:col :let={source} label="Type">{source.collection_type}</:col>
          <:col :let={source} label="Should Download?">
            <.icon name={if source.download_media, do: "hero-check", else: "hero-x-mark"} />
          </:col>
          <:col :let={source} label="" class="flex justify-end">
            <.icon_link href={~p"/sources/#{source.id}/edit"} icon="hero-pencil-square" class="mr-4" />
          </:col>
        </.table>
      </:tab>
    </.tabbed_layout>
  </div>
</div>
