<div class="mb-6 flex gap-3 flex-row items-center">
  <.link href={~p"/sources"}>
    <.icon name="hero-arrow-left" class="w-8 h-8 text-slate-400 hover:text-white transition-colors" />
  </.link>
  <h2 class="font-display font-bold text-[22px] text-white ml-2 truncate">
    Editing "{@source.custom_name}"
  </h2>
</div>

<div class="rounded-xl border border-white/5 bg-midnight-850 px-5 pb-2.5 pt-6 sm:px-7.5 xl:pb-1">
  <div class="max-w-full">
    <div class="flex flex-col gap-10">
      <section
        :if={@source.collection_type == :playlist && @source.selection_mode == :manual}
        class="rounded-xl border border-white/5 bg-midnight-800 px-6 py-5"
      >
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-white">Delayed Downloads Active</h3>
            <p class="max-w-3xl text-sm text-slate-400">
              This playlist is in manual selection mode - indexed items won't download until you pick them
              from the Other tab. Restoring automatic downloads switches it back to normal and clears
              existing delayed-download exclusions for items already indexed.
            </p>
          </div>

          <form method="post" action={~p"/sources/#{@source}/restore_automatic_downloads"}>
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
            <.button
              rounding="rounded-lg"
              data-confirm="Restore automatic downloads for this playlist and allow all indexed items to download?"
            >
              Restore Automatic Downloads
            </.button>
          </form>
        </div>
      </section>

      <section>
        <h3 class="text-2xl font-display text-white">Poster</h3>

        <div class="flex items-center gap-6 mt-4">
          <div class="relative aspect-[2/3] w-32 rounded-lg overflow-hidden border border-white/5 bg-midnight-800 shrink-0">
            <img src={~p"/sources/#{@source}/poster"} class="w-full h-full object-cover" />
          </div>

          <div class="flex flex-col gap-3">
            <form method="post" enctype="multipart/form-data" action={~p"/sources/#{@source}/poster"}>
              <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
              <input type="file" name="poster" accept="image/jpeg,image/png,image/webp" required />
              <.button class="mt-2" rounding="rounded-lg">Upload Poster</.button>
            </form>

            <.link
              :if={@source.custom_poster_filepath}
              href={~p"/sources/#{@source}/poster"}
              method="delete"
              data-confirm="Remove your custom poster and fall back to the auto-downloaded one?"
              class="underline decoration-slate-500 decoration-1 hover:decoration-white text-slate-400 hover:text-white transition-colors w-fit"
            >
              Remove custom poster
            </.link>
          </div>
        </div>
      </section>

      <.source_form
        changeset={@changeset}
        media_profiles={@media_profiles}
        action={~p"/sources/#{@source}"}
        method="patch"
      />
    </div>
  </div>
</div>
