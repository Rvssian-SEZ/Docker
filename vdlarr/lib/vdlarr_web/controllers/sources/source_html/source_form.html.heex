<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  method={@method}
  x-data="{ advancedMode: !!JSON.parse(localStorage.getItem('advancedMode')) }"
  x-init="$watch('advancedMode', value => localStorage.setItem('advancedMode', JSON.stringify(value)))"
>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <section x-data="{ mediaProfileId: null }">
    <section class="flex justify-between items-center mt-4">
      <h3 class="text-2xl font-display text-white">
        General Options
      </h3>
      <span class="cursor-pointer text-slate-400 hover:text-white transition-colors" x-on:click="advancedMode = !advancedMode">
        Editing Mode: <span x-text="advancedMode ? 'Advanced' : 'Standard'"></span>
      </span>
    </section>

    <.input
      field={f[:original_url]}
      type="text"
      label="Source URL"
      help="URL of a channel or playlist (required)"
      x-init="$el.focus()"
    />

    <.input
      field={f[:custom_name]}
      type="text"
      label="Custom Name"
      help="Does not impact indexing or downloading. Will be inferred from the source if left blank"
    />

    <.input
      field={f[:media_profile_id]}
      options={Enum.map(@media_profiles, &{&1.name, &1.id})}
      type="select"
      label="Media Profile"
      help="Sets your preferences for what media to look for and how to store it"
      x-model.fill="mediaProfileId"
    />

    <.input
      field={f[:hidden]}
      type="toggle"
      label="Hidden"
      help="Hides this source from the main Sources grid (visible under Hidden Sources instead). Doesn't affect downloading or indexing"
    />

    <h3 class="mt-8 text-2xl font-display text-white">
      Indexing Options
    </h3>

    <section
      class="space-y-4"
      x-data={
        """
        {
          ...JSON.parse('#{schedule_picker_initial_state(@changeset)}'),
          previewUrl: '#{~p"/sources/schedule_preview"}',
          sourceId: '#{@changeset.data.id || ""}',
          modes: [
            { id: 'interval', label: 'Every…' },
            { id: 'daily', label: 'Daily' },
            { id: 'weekly', label: 'Weekly' },
            { id: 'hourly', label: 'Every N hours' },
            { id: 'once', label: 'Once only' },
            { id: 'custom', label: 'Custom (cron)' }
          ],
          dayNames: ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
          cronSchedule: '',
          frequencyOut: 1440,
          customCron: '',
          timeStr: '03:00',
          preview: null,
          previewTimer: null,
          previewSeq: 0,
          init() {
            this.timeStr = String(this.hour).padStart(2, '0') + ':' + String(this.minute).padStart(2, '0')
            this.weekdays = this.weekdays.map(Number)
            this.customCron = this.raw || ''
            if (!(this.frequency > 0)) this.frequency = this.frequency === -1 ? -1 : 1440
            this.rebuild()
          },
          setMode(mode) {
            this.mode = mode
            if (mode === 'weekly' && this.weekdays.length === 0) this.weekdays = [new Date().getDay()]
            if (mode === 'interval' && !(this.frequency > 0)) this.frequency = 1440
            this.rebuild()
          },
          toggleDay(day) {
            if (this.weekdays.includes(day)) {
              if (this.weekdays.length > 1) this.weekdays = this.weekdays.filter((d) => d !== day)
            } else {
              this.weekdays = [...this.weekdays, day]
            }
            this.rebuild()
          },
          rebuild() {
            const [hh, mm] = this.timeStr.split(':').map(Number)
            const keptFrequency = this.frequency > 0 ? this.frequency : 1440

            if (this.mode === 'interval') {
              this.cronSchedule = ''
              this.frequencyOut = this.frequency
            } else if (this.mode === 'once') {
              this.cronSchedule = ''
              this.frequencyOut = -1
            } else {
              this.frequencyOut = keptFrequency
              if (this.mode === 'daily') {
                this.cronSchedule = `${mm} ${hh} * * *`
              } else if (this.mode === 'weekly') {
                this.cronSchedule = `${mm} ${hh} * * ${[...this.weekdays].sort((a, b) => a - b).join(',')}`
              } else if (this.mode === 'hourly') {
                const every = Number(this.every)
                const hours = []
                for (let h = hh % every; h < 24; h += every) hours.push(h)
                this.cronSchedule = every === 1 ? `${mm} * * * *` : `${mm} ${hours.join(',')} * * *`
              } else {
                this.cronSchedule = this.customCron.trim()
              }
            }

            clearTimeout(this.previewTimer)
            this.previewTimer = setTimeout(() => this.fetchPreview(), 250)
          },
          async fetchPreview() {
            const params = new URLSearchParams({ cron: this.cronSchedule, frequency: this.frequencyOut, source_id: this.sourceId })
            // Only the newest request may update the preview - an older, slower response
            // arriving late must not overwrite it
            const seq = ++this.previewSeq

            // No explicit Accept header - these routes use the browser pipeline, which only
            // accepts html and answers an application/json Accept with a 406
            try {
              const response = await fetch(`${this.previewUrl}?${params}`)
              const body = response.ok ? await response.json() : null
              if (seq !== this.previewSeq) return
              this.preview = body && typeof body.ok === 'boolean' ? body : { ok: false, error: 'Preview unavailable - the schedule will still save' }
            } catch (_error) {
              if (seq !== this.previewSeq) return
              this.preview = { ok: false, error: 'Preview unavailable - the schedule will still save' }
            }
          }
        }
        """
      }
    >
      <div>
        <.label for="schedule-mode">Schedule</.label>
        <div id="schedule-mode" class="mt-2 flex flex-wrap gap-2" role="radiogroup" aria-label="Schedule type">
          <template x-for="option in modes" x-bind:key="option.id">
            <button
              type="button"
              role="radio"
              x-bind:aria-checked="mode === option.id"
              x-on:click="setMode(option.id)"
              x-bind:class="mode === option.id ? 'bg-m3-active text-[#c9e2ff] border-[#2c5a9e]' : 'bg-midnight-800 text-[#c4cfdf] border-[#263343] hover:bg-[#111a25] hover:text-white'"
              class="rounded-full border px-4 py-2 text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7eb7ff]"
              x-text="option.label"
            >
            </button>
          </template>
        </div>
        <.help>
          Indexing checks this source for new videos. For best results, choose the longest gap you can tolerate
        </.help>
      </div>

      <input
        type="hidden"
        name={f[:index_frequency_minutes].name}
        value={f[:index_frequency_minutes].value}
        x-bind:value="frequencyOut"
      />
      <input
        type="hidden"
        name={f[:index_cron_schedule].name}
        value={f[:index_cron_schedule].value}
        x-bind:value="cronSchedule"
      />

      <div x-show="mode === 'interval'" class="flex flex-wrap items-center gap-3 text-white">
        <span>Every</span>
        <select
          aria-label="Index interval"
          x-model.number="frequency"
          x-on:change="rebuild()"
          class="rounded border border-form-strokedark bg-form-input py-2 pl-4 pr-10 text-white outline-none focus:border-primary"
        >
          <option :for={{label, minutes} <- schedule_interval_options()} value={minutes}>
            {String.replace(label, "Daily (recommended)", "Day (recommended)")}
          </option>
          <option
            :if={unlisted_interval(@changeset)}
            value={unlisted_interval(@changeset)}
          >
            {unlisted_interval(@changeset)} minutes (current)
          </option>
        </select>
        <span class="text-sm text-bodydark2">after each index finishes</span>
      </div>

      <div x-show="mode === 'daily'" class="flex flex-wrap items-center gap-3 text-white">
        <span>Every day at</span>
        <input
          type="time"
          aria-label="Time of day"
          x-model="timeStr"
          x-on:change="rebuild()"
          class="rounded border border-form-strokedark bg-form-input px-3 py-2 text-white outline-none focus:border-primary"
        />
      </div>

      <div x-show="mode === 'weekly'" class="space-y-3 text-white">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Days of the week">
          <template x-for="(name, index) in dayNames" x-bind:key="name">
            <button
              type="button"
              x-on:click="toggleDay(index)"
              x-bind:aria-pressed="weekdays.includes(index)"
              x-bind:class="weekdays.includes(index) ? 'bg-m3-active text-[#c9e2ff] border-[#2c5a9e]' : 'bg-midnight-800 text-[#c4cfdf] border-[#263343] hover:text-white'"
              class="h-10 w-12 rounded-lg border text-sm font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-[#7eb7ff]"
              x-text="name"
            >
            </button>
          </template>
        </div>
        <div class="flex items-center gap-3">
          <span>at</span>
          <input
            type="time"
            aria-label="Time of day"
            x-model="timeStr"
            x-on:change="rebuild()"
            class="rounded border border-form-strokedark bg-form-input px-3 py-2 text-white outline-none focus:border-primary"
          />
        </div>
      </div>

      <div x-show="mode === 'hourly'" class="flex flex-wrap items-center gap-3 text-white">
        <span>Every</span>
        <select
          aria-label="Hours between runs"
          x-model.number="every"
          x-on:change="rebuild()"
          class="rounded border border-form-strokedark bg-form-input py-2 pl-4 pr-10 text-white outline-none focus:border-primary"
        >
          <option :for={n <- [1, 2, 3, 4, 6, 8, 12]} value={n}>{if n == 1, do: "hour", else: "#{n} hours"}</option>
        </select>
        <span>including</span>
        <input
          type="time"
          aria-label="First run of the day"
          x-model="timeStr"
          x-on:change="rebuild()"
          class="rounded border border-form-strokedark bg-form-input px-3 py-2 text-white outline-none focus:border-primary"
        />
      </div>

      <div x-show="mode === 'custom'">
        <input
          type="text"
          aria-label="Cron expression"
          placeholder="0 3 * * *"
          x-model="customCron"
          x-on:input="rebuild()"
          class="w-full rounded border border-form-strokedark bg-form-input px-5 py-3 font-mono text-white outline-none focus:border-primary"
        />
        <.help>{Phoenix.HTML.raw(cron_schedule_help())}</.help>
      </div>

      <div class="rounded-xl border border-[#202b38] bg-midnight-850 p-4" aria-live="polite">
        <template x-if="preview && preview.ok">
          <div>
            <p class="text-sm font-medium text-[#c9e2ff]" x-text="preview.summary"></p>
            <ul x-show="preview.next_runs.length > 0" class="mt-2 grid gap-1 text-sm tabular-nums text-bodydark2 sm:grid-cols-2">
              <template x-for="(run, index) in preview.next_runs" x-bind:key="index">
                <li class="flex items-center gap-2">
                  <span class="text-[#7d8da2]" x-text="index === 0 ? 'Next' : 'Then'"></span>
                  <span x-text="run"></span>
                </li>
              </template>
            </ul>
          </div>
        </template>
        <p x-show="preview && !preview.ok" class="text-sm text-[#ff8a8f]" x-text="preview && preview.error"></p>
        <p x-show="!preview" class="text-sm text-bodydark2">Working out the schedule…</p>
      </div>

      <.error :for={msg <- Enum.map(f[:index_cron_schedule].errors, &translate_error/1)}>{msg}</.error>
      <.error :for={msg <- Enum.map(f[:index_frequency_minutes].errors, &translate_error/1)}>{msg}</.error>
    </section>

    <h3 class="mt-8 text-2xl font-display text-white">
      Downloading Options
    </h3>

    <.input
      field={f[:download_media]}
      type="toggle"
      label="Download Media"
      help="Unchecking still indexes media but it won't be downloaded until you enable this option"
    />

    <.input
      :if={@show_delay_automatic_download}
      type="toggle"
      name="delay_automatic_download"
      value="false"
      label="Delay Automatic Download"
      help="For playlists only. Index first, then pick which items to download from the source's Other tab"
    />

    <.input
      field={f[:cookie_behaviour]}
      options={friendly_cookie_behaviours()}
      type="select"
      label="Cookie Behaviour"
      help="Uses your YouTube cookies for this source (if configured). 'When Needed' tries to minimize cookie usage except for certain indexing and downloading tasks. See docs"
    />

    <section x-show="advancedMode">
      <.input
        field={f[:min_duration_seconds]}
        type="number"
        label="Minimum Duration (seconds)"
        min="0"
        help="Minimum duration of the media to be downloaded. Can be blank"
      />

      <.input
        field={f[:max_duration_seconds]}
        type="number"
        label="Maximum Duration (seconds)"
        min="0"
        help="Maximum duration of the media to be downloaded. Can be blank"
      />
    </section>

    <section x-data={"{ cutoffDate: '#{f[:download_cutoff_date].value}' }"}>
      <.input
        field={f[:download_cutoff_date]}
        type="text"
        label="Download Cutoff Date"
        placeholder="YYYY-MM-DD"
        maxlength="10"
        pattern="((?:19|20)[0-9][0-9])-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])"
        title="YYYY-MM-DD"
        help="Only download media uploaded after this date. Leave blank to download all media. Must be in YYYY-MM-DD format. Older media already downloaded is kept; changing this date only affects what's downloaded going forward"
        x-model="cutoffDate"
      >
        <:input_append>
          <.input
            prompt="Select preset"
            name="download_cutoff_date_preset"
            value=""
            options={cutoff_date_presets()}
            type="select"
            inputclass="w-30 lg:w-60 ml-2 md:ml-4"
            x-on:change={"cutoffDate = $event.target.value || '#{f[:download_cutoff_date].value}'"}
          />
        </:input_append>
      </.input>
    </section>

    <.input
      field={f[:retention_period_days]}
      type="number"
      label="Retention Period (days)"
      min="0"
      help="Days between when media is <em>downloaded</em> and when it's deleted. Leave blank to keep media indefinitely"
      html_help={true}
    />

    <section x-show="advancedMode">
      <h3 class="mt-8 text-2xl font-display text-white">
        Advanced Options
      </h3>
      <p class="text-sm mt-2">
        Tread carefully
      </p>

      <.input
        field={f[:title_filter_regex]}
        type="text"
        label="Title Filter Regex"
        placeholder="(?i)^How to Bike$"
        help={title_filter_regex_help()}
        html_help={true}
      />

      <section
        x-data={
          """
          {
            placeholders: JSON.parse('#{output_path_template_override_placeholders(@media_profiles)}'),
            inputValue: null,
            folders: []
          }
          """
        }
        x-init="fetchMediaFolders().then((f) => (folders = f))"
        x-on:load-template="inputValue = placeholders[mediaProfileId]"
      >
        <.input
          id="output-path-template-override"
          field={f[:output_path_template_override]}
          type="text"
          inputclass="font-mono"
          label="Output path template override"
          help={output_path_template_override_help()}
          html_help={true}
          x-bind:placeholder="placeholders[mediaProfileId]"
          x-model.fill="inputValue"
        />

        <select
          x-show="folders.length > 0"
          x-on:change="insertAtCursor(document.getElementById('output-path-template-override'), $event.target.value); $event.target.value = ''"
          class="mt-2 rounded border border-form-strokedark bg-form-input px-3 py-2 text-sm text-white outline-none"
        >
          <option value="">Insert existing folder…</option>
          <template x-for="folder in folders">
            <option x-text="folder" x-bind:value="folder"></option>
          </template>
        </select>
      </section>
    </section>

    <.button class="my-10 sm:mb-7.5 w-full sm:w-auto" rounding="rounded-lg">Save Source</.button>
  </section>
</.simple_form>
