<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <h2 class="font-display font-bold text-[22px] text-white">Dashboard</h2>

  <div class="relative" x-data="{ addNewOpen: false }" x-on:click.outside="addNewOpen = false">
    <button
      type="button"
      x-on:click="addNewOpen = !addNewOpen"
      class="flex items-center gap-1.5 bg-gradient-to-r from-indigo-500 to-violet-500 hover:from-indigo-400 hover:to-violet-400 text-white font-semibold text-[12px] px-4 py-2 rounded-lg shadow-lg shadow-indigo-500/25 transition-all"
    >
      <span class="font-bold">+</span> Add New
      <.icon name="hero-chevron-down" class="w-[11px] h-[11px] transition-transform" x-bind:class="addNewOpen && 'rotate-180'" />
    </button>

    <div
      x-cloak
      x-show="addNewOpen"
      x-transition
      class="absolute right-0 top-[calc(100%+8px)] w-64 bg-midnight-800 border border-white/10 rounded-xl shadow-2xl shadow-black/60 overflow-hidden divide-y divide-white/5 z-30"
    >
      <.link href={~p"/sources/new"} class="flex items-center gap-3 p-3 hover:bg-white/5 transition-colors">
        <div class="w-8 h-8 rounded-lg bg-indigo-500/15 flex items-center justify-center flex-none">
          <.icon name="hero-tv" class="w-4 h-4 text-indigo-400" />
        </div>
        <div>
          <div class="text-[12.5px] font-semibold text-white">New Source</div>
          <div class="text-[11px] text-slate-500">Add and monitor a new source</div>
        </div>
      </.link>
      <.link href={~p"/sources/new_video"} class="flex items-center gap-3 p-3 hover:bg-white/5 transition-colors">
        <div class="w-8 h-8 rounded-lg bg-indigo-500/15 flex items-center justify-center flex-none">
          <.icon name="hero-play" class="w-4 h-4 text-indigo-400" />
        </div>
        <div>
          <div class="text-[12.5px] font-semibold text-white">Single Video</div>
          <div class="text-[11px] text-slate-500">Add one standalone item</div>
        </div>
      </.link>
    </div>
  </div>
</div>

<div class="rounded-xl border border-white/5 bg-midnight-850 shadow-default">
  <div class="max-w-full overflow-x-auto p-4">
    {live_render(@conn, VdlarrWeb.Sources.SourceLive.IndexGridLive,
      session: %{
        "show_hidden" => false,
        "initial_sort_key" => :custom_name,
        "initial_sort_direction" => :asc,
        "results_per_page" => 30
      }
    )}
  </div>
</div>
