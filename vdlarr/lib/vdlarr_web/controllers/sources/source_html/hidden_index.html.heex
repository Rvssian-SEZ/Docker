<div class="mb-6 flex gap-3 flex-row items-center justify-between">
  <h2 class="font-display font-bold text-[22px] text-white">Hidden Sources</h2>
</div>

<div class="rounded-xl border border-white/5 bg-midnight-850 shadow-default">
  <div class="max-w-full overflow-x-auto p-4">
    {live_render(@conn, VdlarrWeb.Sources.SourceLive.IndexGridLive,
      session: %{
        "show_hidden" => true,
        "initial_sort_key" => :custom_name,
        "initial_sort_direction" => :asc,
        "results_per_page" => 30
      }
    )}
  </div>
</div>
