<div class="flex flex-col">
  <p class="mb-4 px-1 text-sm text-[#92a1b4]" data-testid="sources-summary">
    {format_count(@summary.count)} {if @show_hidden, do: "hidden ", else: ""}{if @summary.count == 1,
      do: "channel",
      else: "channels"} · {format_count(@summary.monitored)} monitored · {format_size(@summary.size)}
  </p>

  <div class="mb-4 flex flex-wrap items-center gap-2.5 px-1">
    <div class="inline-flex overflow-hidden rounded-lg border border-white/10" role="group" aria-label="View">
      <button
        type="button"
        phx-click="set_view_mode"
        phx-value-mode="poster"
        aria-pressed={to_string(@view_mode == :poster)}
        class={[
          "px-3 py-1.5 text-[12px] font-medium transition-colors",
          if(@view_mode == :poster, do: "bg-indigo-500 text-white", else: "text-slate-400 hover:bg-white/5 hover:text-white")
        ]}
      >
        Poster
      </button>
      <button
        type="button"
        phx-click="set_view_mode"
        phx-value-mode="table"
        aria-pressed={to_string(@view_mode == :table)}
        class={[
          "px-3 py-1.5 text-[12px] font-medium transition-colors",
          if(@view_mode == :table, do: "bg-indigo-500 text-white", else: "text-slate-400 hover:bg-white/5 hover:text-white")
        ]}
      >
        Table
      </button>
    </div>

    <form phx-change="sort_update" id="source-sort-form">
      <select
        name="sort_key"
        aria-label="Sort channels"
        class="rounded-lg border border-white/10 bg-midnight-800 px-2.5 py-1.5 text-[12px] text-slate-300 outline-none focus:border-indigo-400/50"
      >
        <option value="custom_name" selected={@sort_key == :custom_name}>Sort: Name</option>
        <option value="total_count" selected={@sort_key == :total_count}>Sort: Videos</option>
        <option value="downloaded_count" selected={@sort_key == :downloaded_count}>Sort: Downloaded</option>
        <option value="pending_count" selected={@sort_key == :pending_count}>Sort: Pending</option>
        <option value="media_size_bytes" selected={@sort_key == :media_size_bytes}>Sort: Size</option>
        <option value="media_profile_name" selected={@sort_key == :media_profile_name}>Sort: Media Profile</option>
        <option value="enabled" selected={@sort_key == :enabled}>Sort: Monitored</option>
      </select>
    </form>
    <button
      type="button"
      id="sort-direction-toggle"
      phx-click="sort_update"
      phx-value-sort_key={@sort_key}
      class="rounded-lg border border-white/10 p-1.5 text-slate-400 transition-colors hover:bg-white/5 hover:text-white"
      title="Toggle sort direction"
      aria-label={if @sort_direction == :asc, do: "Sort ascending", else: "Sort descending"}
    >
      <.icon name={if @sort_direction == :asc, do: "hero-chevron-up", else: "hero-chevron-down"} class="h-4 w-4" />
    </button>

    <form phx-change="search" phx-submit="search" id="source-search-form" class="ml-auto">
      <div class="flex w-56 items-center gap-2 rounded-lg border border-white/10 bg-black/30 px-3 py-1.5 transition-shadow focus-within:border-indigo-400/40 focus-within:ring-1 focus-within:ring-indigo-400/60">
        <.icon name="hero-magnifying-glass" class="h-[14px] w-[14px] flex-none text-slate-500" />
        <input
          type="text"
          name="search_term"
          value={@search_term}
          placeholder="Filter channels…"
          aria-label="Filter channels"
          phx-debounce="300"
          class="w-full border-none bg-transparent p-0 text-[12px] text-slate-200 placeholder-slate-500 outline-none focus:ring-0"
        />
      </div>
    </form>
  </div>

  <p :if={@sources == []} class="px-1 py-10 text-center text-sm text-[#92a1b4]">
    {if @search_term, do: "No channels match \"#{@search_term}\".", else: "No channels yet."}
  </p>

  <div :if={@view_mode == :poster} class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
    <div
      :for={source <- @sources}
      class="group relative overflow-hidden rounded-xl border border-m3-border bg-m3-card transition duration-200 hover:-translate-y-0.5 hover:border-[#334354] hover:shadow-xl hover:shadow-black/40"
      data-testid="source-grid-item"
    >
      <.link href={~p"/sources/#{source.id}"} class="relative block aspect-square w-full bg-midnight-800" aria-label={source.custom_name}>
        <img
          :if={source.resolved_poster_filepath}
          src={~p"/sources/#{source.id}/poster?size=thumb"}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
        <div :if={!source.resolved_poster_filepath} class="flex h-full w-full items-center justify-center">
          <.icon name="hero-photo" class="h-12 w-12 text-slate-600" />
        </div>
        <div :if={!source.enabled} class="absolute inset-0 bg-black/55"></div>
        <span class={[
          "m3-badge absolute right-2 top-2 backdrop-blur",
          if(source.enabled, do: "bg-[#063e2e]/90 text-[#66e6b1]", else: "bg-[#293645]/90 text-[#b9c7dc]")
        ]}>
          {if source.enabled, do: "Monitored", else: "Paused"}
        </span>
        <span
          :if={source.pending_count > 0}
          class="m3-badge absolute bottom-2 left-2 bg-[#8c4500]/90 text-[#ffd09f] backdrop-blur"
          data-testid="pending-badge"
        >
          {format_count(source.pending_count)} pending
        </span>
      </.link>

      <div class="absolute left-2 top-2 transition-opacity sm:opacity-0 sm:focus-within:opacity-100 sm:group-hover:opacity-100">
        <.live_component
          module={VdlarrWeb.Sources.SourceLive.SourceEnableToggle}
          source={source}
          id={"source_#{source.id}_enabled"}
        />
      </div>

      <div class="absolute right-2 top-9 opacity-0 transition-opacity focus-within:opacity-100 group-hover:opacity-100">
        <.icon_link href={~p"/sources/#{source.id}/edit"} icon="hero-pencil-square" class="rounded bg-black/60 p-1" />
      </div>

      <div
        class="flex h-1 bg-[#273443]"
        title={"#{format_count(source.downloaded_count)} downloaded · #{format_count(source.pending_count)} pending · #{format_count(source.breakdown.skipped)} skipped"}
        data-testid="source-progress"
      >
        <div class="h-full bg-[#4d98ff]" style={"width: #{source.breakdown.downloaded}%"}></div>
        <div class="h-full bg-[#ff9f43]" style={"width: #{source.breakdown.pending}%"}></div>
      </div>

      <div class="p-3">
        <.link
          href={~p"/sources/#{source.id}"}
          class="block truncate text-[13px] font-semibold text-[#edf1f7] transition-colors hover:text-[#8dc2ff]"
          title={source.custom_name}
        >
          {source.custom_name}
        </.link>
        <.link
          href={~p"/sources/#{source.id}/#tab-downloaded"}
          class="mt-1 block truncate text-[11px] tabular-nums text-[#7d8da2] transition-colors hover:text-[#b9c7dc]"
        >
          {format_count(source.downloaded_count)} of {format_count(source.total_count)} downloaded
        </.link>
      </div>
    </div>
  </div>

  <div :if={@view_mode == :table and @sources != []} class="max-w-full overflow-x-auto">
    <table class="w-full min-w-[820px] border-collapse text-left">
      <thead>
        <tr class="bg-white/5 text-[11px] uppercase tracking-wide text-slate-500">
          <th class="px-3 py-2.5 font-semibold">Channel</th>
          <th class="px-3 py-2.5 font-semibold">Status</th>
          <th class="px-3 py-2.5 font-semibold">Profile</th>
          <th class="px-3 py-2.5 text-right font-semibold">Downloaded</th>
          <th class="px-3 py-2.5 text-right font-semibold">Pending</th>
          <th class="px-3 py-2.5 text-right font-semibold">Size</th>
          <th class="px-3 py-2.5 font-semibold">Next Index</th>
          <th class="px-3 py-2.5 font-semibold"><span class="sr-only">Monitored</span></th>
        </tr>
      </thead>
      <tbody>
        <tr :for={source <- @sources} class="m3-row" data-testid="source-table-row">
          <td class="px-3 py-2.5">
            <div class="flex items-center gap-3">
              <div class="flex h-9 w-9 flex-none items-center justify-center overflow-hidden rounded-md bg-midnight-800">
                <img
                  :if={source.resolved_poster_filepath}
                  src={~p"/sources/#{source.id}/poster?size=thumb"}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
                <.icon :if={!source.resolved_poster_filepath} name="hero-photo" class="h-4 w-4 text-slate-600" />
              </div>
              <.link
                href={~p"/sources/#{source.id}"}
                class="truncate font-medium text-[#edf1f7] transition-colors hover:text-[#8dc2ff]"
              >
                {source.custom_name}
              </.link>
            </div>
          </td>
          <td class="px-3 py-2.5">
            <span class={[
              "m3-badge",
              if(source.enabled, do: "bg-[#063e2e] text-[#66e6b1]", else: "bg-[#293645] text-[#b9c7dc]")
            ]}>
              {if source.enabled, do: "Monitored", else: "Paused"}
            </span>
          </td>
          <td class="px-3 py-2.5 text-[#b9c7dc]">{source.media_profile_name}</td>
          <td class="whitespace-nowrap px-3 py-2.5 text-right tabular-nums text-[#edf1f7]">
            {format_count(source.downloaded_count)}
            <span class="text-[#7d8da2]">/ {format_count(source.total_count)}</span>
          </td>
          <td class={[
            "px-3 py-2.5 text-right tabular-nums",
            if(source.pending_count > 0, do: "text-[#ffd09f]", else: "text-[#7d8da2]")
          ]}>
            {format_count(source.pending_count)}
          </td>
          <td class="whitespace-nowrap px-3 py-2.5 text-right tabular-nums text-[#b9c7dc]">
            {if source.media_size_bytes > 0, do: format_size(source.media_size_bytes), else: "—"}
          </td>
          <td class={["whitespace-nowrap px-3 py-2.5 text-xs", elem(source.next_index, 1) && "text-[#7d8da2]"]}>
            {elem(source.next_index, 0)}
          </td>
          <td class="px-3 py-2.5">
            <.live_component
              module={VdlarrWeb.Sources.SourceLive.SourceEnableToggle}
              source={source}
              id={"source_#{source.id}_enabled_row"}
            />
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <section class="my-5 flex justify-center">
    <.live_pagination_controls page_number={@page} total_pages={@total_pages} />
  </section>
</div>
