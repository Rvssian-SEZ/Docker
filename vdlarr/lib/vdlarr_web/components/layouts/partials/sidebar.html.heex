<aside
  x-bind:class="sidebarVisible ? 'translate-x-0' : '-translate-x-full'"
  class={[
    "-translate-x-full absolute left-0 top-0 z-9999 flex h-screen w-65 flex-col overflow-y-hidden justify-between",
    "bg-midnight-900 border-r border-white/5 duration-300 ease-linear shadow-lg sm:shadow-none lg:static lg:translate-x-0"
  ]}
  @click.outside="sidebarVisible = false"
>
  <section>
    <div class="flex items-center justify-between gap-2 px-6 py-4 border-b border-white/5">
      <a href={~p"/"} class="flex items-center">
        <img src={~p"/images/logo-2026-08-27.svg"} alt="VDLarr" class="w-auto" />
      </a>

      <button class="block mt-3 lg:hidden" @click.stop="sidebarVisible = !sidebarVisible">
        <.icon name="hero-arrow-left" class="fill-current text-slate-400" />
      </button>
    </div>
    <div class="no-scrollbar flex flex-col overflow-y-auto duration-300 ease-linear">
      <nav class="mt-3 px-4 py-4 lg:px-6">
        <h3 class="mb-4 ml-3 text-[10px] font-semibold uppercase tracking-wider text-slate-600">
          <span>Menu</span>
        </h3>
        <div class="flex flex-col justify-between">
          <ul class="mb-6 flex flex-col gap-1">
            <.sidebar_item
              icon="hero-tv"
              text="Dashboard"
              href={~p"/sources"}
              active={nav_active?(@conn.request_path, "/sources")}
            />
          </ul>
        </div>

        <h3 class="mb-4 ml-3 text-[10px] font-semibold uppercase tracking-wider text-slate-600">
          <span>Library</span>
        </h3>
        <div class="flex flex-col justify-between">
          <ul class="mb-6 flex flex-col gap-1">
            <.sidebar_item
              icon="hero-chart-bar"
              text="Stats"
              href={~p"/stats"}
              active={nav_active?(@conn.request_path, "/stats")}
            />
            <.sidebar_item
              :if={Settings.get!(:show_hidden_sources_menu)}
              icon="hero-eye-slash"
              text="Hidden Sources"
              href={~p"/sources/hidden"}
              active={nav_active?(@conn.request_path, "/sources/hidden")}
            />
            <.sidebar_item
              icon="hero-adjustments-vertical"
              text="Media Profiles"
              href={~p"/media_profiles"}
              active={nav_active?(@conn.request_path, "/media_profiles")}
            />
            <.sidebar_item
              icon="hero-arrow-down-tray"
              text="Wanted"
              href={~p"/wanted"}
              active={nav_active?(@conn.request_path, "/wanted")}
            />
            <.sidebar_item
              icon="hero-queue-list"
              text="Activity"
              href={~p"/activity"}
              active={nav_active?(@conn.request_path, "/activity")}
            />
          </ul>
        </div>

        <h3 class="mb-4 ml-3 text-[10px] font-semibold uppercase tracking-wider text-slate-600">
          <span>System</span>
        </h3>
        <div class="flex flex-col justify-between">
          <ul class="mb-6 flex flex-col gap-1">
            <.sidebar_item
              icon="hero-document-text"
              text="Logs"
              href={~p"/logs"}
              active={nav_active?(@conn.request_path, "/logs")}
            />
            <.sidebar_item
              icon="hero-cog-6-tooth"
              text="Settings"
              href={~p"/settings"}
              active={nav_active?(@conn.request_path, "/settings")}
            />
          </ul>
        </div>
      </nav>
    </div>
  </section>
  <section>
    <nav class="px-4 py-4 lg:px-6 border-t border-white/5">
      <ul class="mb-6 flex flex-col gap-1">
        <li :if={VdlarrWeb.Plugs.session_login_enabled?()}>
          <.link
            href={~p"/logout"}
            method="delete"
            class="font-medium group relative flex items-center gap-2.5 rounded-lg px-3 py-2 text-slate-400 hover:text-white hover:bg-white/5 transition-colors"
          >
            <.icon name="hero-arrow-right-on-rectangle" /> Logout
          </.link>
        </li>
      </ul>
      <div class="flex items-center justify-between px-3 text-[11px] text-slate-600">
        <span>VDLarr {Application.spec(:vdlarr)[:vsn]} · yt-dlp {Settings.get!(:yt_dlp_version)}</span>
        <span class="text-emerald-500">●</span>
      </div>
    </nav>
  </section>
</aside>
