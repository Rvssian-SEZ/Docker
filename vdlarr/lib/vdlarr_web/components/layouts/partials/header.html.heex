<header class="sticky top-0 z-999 flex h-[70px] w-full flex-none items-center gap-4 border-b border-[#17202b] bg-midnight-900/90 px-5 backdrop-blur-xl lg:px-8">
  <button
    class="z-99999 grid h-10 w-10 flex-none place-items-center rounded-full text-[#edf1f7] hover:bg-white/5 lg:hidden"
    @click.stop="sidebarVisible = !sidebarVisible"
    aria-label="Open menu"
  >
    <.material_icon name="menu" />
  </button>

  <form action={~p"/search"} class="flex h-11 min-w-0 max-w-[560px] flex-1 items-center gap-3 rounded-xl border border-[#263343] bg-midnight-800 px-4 shadow-inner">
    <.material_icon name="search" class="text-[#87a0bd]" />
    <input
      type="text"
      name="q"
      value={@params["q"]}
      placeholder="Search all media..."
      class="w-full border-0 bg-transparent p-0 text-sm text-white placeholder:text-[#74859a] focus:outline-none focus:ring-0"
    />
  </form>

  <div class="ml-auto flex flex-none items-center gap-1">
    <.link
      href={~p"/sources/new"}
      class="grid h-10 w-10 place-items-center rounded-full text-[#afbdd0] hover:bg-white/5 hover:text-white"
      title="Add source"
    >
      <.material_icon name="add_circle" />
    </.link>
    <.link
      :if={VdlarrWeb.Plugs.session_login_enabled?()}
      href={~p"/logout"}
      method="delete"
      class="ml-1 grid h-10 w-10 place-items-center rounded-full bg-[#263241] text-[#edf1f7] hover:bg-[#2f3d4f]"
      title="Logout"
    >
      <.material_icon name="logout" />
    </.link>
  </div>
</header>
