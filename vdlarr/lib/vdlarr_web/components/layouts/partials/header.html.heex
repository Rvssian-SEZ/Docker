<header class="sticky top-0 z-999 flex min-h-20 w-full bg-midnight-900 border-b border-white/5">
  <div class="flex flex-grow items-center justify-between lg:justify-end px-4 py-4 md:px-6 2xl:px-11">
    <div class="flex items-center gap-2 sm:gap-4 lg:hidden w-2/6">
      <section class="pr-1">
        <img src={~p"/images/icon-2024-03-20.png"} alt="VDLarr" class="w-10" />
      </section>

      <button
        class="z-99999 block mx-2 rounded-lg border border-white/5 bg-midnight-850 p-1.5 shadow-sm lg:hidden"
        @click.stop="sidebarVisible = !sidebarVisible"
      >
        <.icon name="hero-bars-3" class="text-white" />
      </button>
    </div>
    <div class="bg-midnight-800 border border-white/5 rounded-lg w-4/6 lg:w-3/6 xl:w-2/6">
      <div class="relative">
        <span class="absolute left-2 top-1/2 -translate-y-1/2 flex text-slate-500">
          <.icon name="hero-magnifying-glass" />
        </span>
        <form action={~p"/search"}>
          <input
            type="text"
            name="q"
            value={@params["q"]}
            placeholder="Search all media..."
            class="w-full bg-transparent text-white placeholder:text-slate-500 pl-9 pr-4 border-0 focus:ring-0 focus:outline-none"
          />
        </form>
      </div>
    </div>
  </div>
</header>
