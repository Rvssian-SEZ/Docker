# Copy to .env and edit. No inline comments on value lines (pydantic-settings).

SECRET_KEY=generate-a-long-random-string
DEBUG=false

DATABASE_URL=sqlite+aiosqlite:////data/app.db
AUDIT_DATABASE_URL=sqlite+aiosqlite:////data/audit.db

# Encrypts Graph/Authentik/AD secrets stored in the app DB (Settings UI).
# This is the ONE secret allowed to live in the environment -- generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing/rotating this key makes every encrypted setting unreadable; the app
# degrades to "not configured" for that section rather than crashing, but
# the values must be re-entered.
FERNET_KEY=generate-with-cryptography.fernet.Fernet.generate_key

# Break-glass local admin. Created on first boot if missing, with a random
# password + TOTP secret logged ONCE to container logs -- change it via the
# UI immediately, this is only here as an initial-bootstrap override.
BREAKGLASS_USERNAME=breakglass
BREAKGLASS_PASSWORD=change-me-immediately

CA_CERT_PATH=/certs/step-ca-root.pem
