POSTGRES_DB=coffer
POSTGRES_USER=coffer
POSTGRES_PASSWORD=

SECRET_KEY_BASE=
PHX_HOST=
# Only needed behind a TLS-terminating reverse proxy (e.g. SAA's NPM setup) —
# leave unset for a bare deployment with no proxy (defaults to plain http on
# the same port the app listens on).
URL_SCHEME=
URL_PORT=

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Optional — powers the "Sync from Snipe-IT" button on the Inventory page.
# Leave both unset to disable it entirely. SNIPEIT_API_TOKEN is a personal
# API token minted for a Snipe-IT user (Account Settings > API, or
# `php artisan snipeit:make-api-key --user_id=<id>` inside the Snipe-IT
# container) — a dedicated least-privilege user is recommended for anything
# beyond a homelab test instance.
SNIPEIT_URL=
SNIPEIT_API_TOKEN=
